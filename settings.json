{
  "icon_theme": "Warm Charmed Icons",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_line_height": "comfortable",
  "line_indicator_format": "long",
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "One Dark"
  },
  "experimental.theme_overrides": {
    "colors": {
      "background": "#000000EE",
      "editor.background": "#000000EE",
      "terminal.background": "#000000EE",
      "panel.background": "#000000EE",
      "status_bar.background": "#000000EE",
      "tab_bar.background": "#000000EE"
    },
    "syntax": {
      "keyword": {
        "color": "#ff757f"
      },
      "string": {
        "color": "#c3e88d"
      }
    }
  },
  "languages": {
    "Swift": {
      "enable_language_server": true,
      "language_servers": ["sourcekit-lsp"],
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "format_on_save": "off",
  "minimap": {
    "show": "auto"
  },
  "gutter": {
    "line_numbers": true,
    "runnables": true,
    "breakpoints": true,
    "folds": false,
    "min_line_number_digits": 1
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true,
    "agent_review": false
  },
  "project_panel": {
    "dock": "right"
  },
  "status_bar": {
    "show": false
  },
  "scrollbar": {
    "show": "never"
  },
  "language_models": {
    "open_router": {
      "available_models": [
        {
          "name": "qwen/qwen3.6-plus:free",
          "display_name": "Qwen 3.6 Plus (Free)",
          "max_tokens": 1000000
        }
      ]
    }
  }
}
